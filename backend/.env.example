APP_NAME=Gestor Inteligente de Reviews
ENV=development
DATABASE_URL=sqlite:///./gestor_reviews.db
SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Lista JSON de orígenes completos del frontend; en Render usar su dominio HTTPS.
CORS_ORIGINS='["http://localhost:5173"]'

# IA: configuración opcional hasta que se solicite un análisis.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1024

# SerpApi: configuración opcional hasta construir el cliente interno.
SERPAPI_API_KEY=
SERPAPI_PAGE_SIZE=5
SERPAPI_MAX_PAGES=3
SERPAPI_SORT_BY=newestFirst
SERPAPI_TIMEOUT_SECONDS=30

# Importación manual: requiere además una conexión Google habilitada por negocio.
EXTERNAL_IMPORT_ENABLED=false
EXTERNAL_IMPORT_PAGE_SIZE=5
EXTERNAL_IMPORT_MAX_PAGES=1
EXTERNAL_IMPORT_ALLOW_LIMITED_BATCHES=false
EXTERNAL_IMPORT_TENANT_REQUEST_BUDGET=1
EXTERNAL_IMPORT_ACCOUNT_REQUEST_BUDGET=5
EXTERNAL_IMPORT_BUDGET_WINDOW_SECONDS=3600

